{
    "input":{
        "path":"tests/data/modis_test.tif"
    },
    "output":{
        "path":"out"
    },
    "params":{
        "filtering":{
        },
        "ef":{
            "check":{
                "threshold": 0.02
            },
            "models": [
            {
                "name": "model1",
                "dry_edge": {
                    "type": "LinearEdge",
                    "config": {
                        "interval_type": "size",
                        "interval_nb": 20,
                        "percentile": [98, 100],
                        "selection": "median"
                    }
                },
                "wet_edge": {
                    "type": "LinearEdge",
                    "config": {
                        "interval_type": "size",
                        "interval_nb": 20,
                        "percentile": [0, 2],
                        "selection": "median"
                    }
                },
                "var": "albedo"
            },
            {
                "name": "model2",
                "dry_edge": {
                    "type": "LinearEdge",
                    "config": {
                        "interval_type": "density",
                        "interval_nb": 20,
                        "percentile": [95, 100],
                        "selection": "median"
                    }
                },
                "wet_edge": {
                    "type": "FlatEdge",
                    "config": {"selection": "min"}
                },
                "var": "lai"
            }
            ],
            "options":{
                "selection": false,
                "merging": "mean"
            }
        },
        "seb":{
            "use_topo": false,
            "g_models": ["choudhury","kustas"]
        }
    }
}